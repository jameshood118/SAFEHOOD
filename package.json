{
  "name": "safehood",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint:md": "markdownlint '**/*.md'",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "precheck": "bash ./scripts/precheck.sh",
    "check": "npm run typecheck && npm run lint && npm run lint:md && npm run format:check",
    "prepare": "husky",
    "dev": "concurrently -n \"VITE,SUPA\" -c \"blue,green\" \"npm run vite:start\" \"npm run supa:start\"",
    "dev:full": "concurrently -n \"VITE,SUPA,API,HEALTH\" -c \"blue,green,magenta,cyan\" \"npm run vite:start\" \"npm run supa:start\" \"npm run api:start\" \"npm run health:launch\"",
    "vite:start": "vite",
    "supa:start": "supabase start",
    "api:start": "echo 'API script placeholder'",
    "health:launch": "echo 'Health check placeholder'",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fortawesome/fontawesome-svg-core": "7.1.0",
    "@fortawesome/free-solid-svg-icons": "7.1.0",
    "@fortawesome/react-fontawesome": "3.1.0",
    "@mui/icons-material": "7.3.5",
    "@mui/material": "7.3.5",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "5.55.0",
    "ag-grid-community": "35.2.0",
    "ag-grid-react": "35.2.0",
    "dotenv": "17.3.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-dropzone": "14.2.3",
    "react-hook-form": "7.53.0",
    "react-router-dom": "6.26.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.48.0",
    "@typescript-eslint/parser": "8.48.0",
    "@vitejs/plugin-react": "5.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "9.2.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "markdownlint-cli": "0.42.0",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.2",
    "vite": "7.2.4"
  }
}
